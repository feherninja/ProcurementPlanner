@page "/components"
@using ProcurementPlanner.Interfaces
@using ProcurementPlanner.Models
@inject IComponentService ComponentService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Komponensek</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudPaper Class="pa-4">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h4">Komponensek</MudText>

            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                <MudSelect T="int"
                           Label="Cég"
                           Value="CompanyContext.ActiveCompanyId"
                           ValueChanged="OnCompanyChanged"
                           Dense="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="min-width: 280px;">
                    @foreach (var c in companies)
                    {
                        <MudSelectItem T="int" Value="@c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">
                    Komponens hozzáadása
                </MudButton>
            </MudStack>
        </MudStack>


        <MudDataGrid @ref="dataGrid"
                     T="Component"
                     Items="@components"
                     Filterable="true"
                     FilterMode="DataGridFilterMode.Simple"
                     SortMode="SortMode.Single"
                     Groupable="false"
                     Loading="@loading"
                     Hover="true"
                     Dense="true">

            <Columns>
                <HierarchyColumn T="Component"/>
                <PropertyColumn Property="x => x.Name" Title="Név"/>
                <PropertyColumn Property="x => x.Description" Title="Leírás"/>
                <PropertyColumn Property="x => x.PartNumber" Title="Céges termékszám"/>
                <PropertyColumn Property="x => x.ExternalNumber" Title="Schwarzmüller termékszám"/>
                <PropertyColumn Property="x => x.Stock" Title="Raktármennyiség"/>
                <PropertyColumn Property="x => x.OrderPackageSize" Title="Rendelési kötegszám"/>
                <PropertyColumn Property="x => x.Price" Title="Ár" Format="N2"/>
                <PropertyColumn Property="x => x.CreatedAt" Title="Létrehozva" Format="yyyy-MM-dd"/>
                <PropertyColumn Property="x => x.UpdatedAt" Title="Módosítva" Format="yyyy-MM-dd"/>

                <TemplateColumn Title="Funkciók" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudStack Row Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(context.Item))"
                                           Title="Szerkesztés"/>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenDeleteDialog(context.Item))"
                                           Title="Törlés"/>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <ChildRowContent>
                <MudCard Class="ma-2" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">@context.Item.Name — termékek listája</MudText>

                        @if (context.Item.ItemComponents.Any())
                        {
                            <MudSimpleTable Style="overflow-x: auto;" Dense="true">
                                <thead>
                                <tr>
                                    <th>Cikkszám</th>
                                    <th>Rajzszám</th>
                                    <th>Termék neve</th>
                                    <th>Leírás</th>
                                    <th>Mennyiség</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var itemComponent in context.Item.ItemComponents)
                                {
                                    <tr>
                                        <td>@itemComponent.Item.PartNumber</td>
                                        <td>@itemComponent.Item.DrawingNumber</td>
                                        <td>@itemComponent.Item.Name</td>
                                        <td>@itemComponent.Item.Description</td>
                                        <td>@itemComponent.Quantity</td>
                                    </tr>
                                }
                                </tbody>
                            </MudSimpleTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Ez a komponens egyetlen termékhez sincs hozzárendelve.
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </ChildRowContent>

            <NoRecordsContent>
                <MudText Typo="Typo.body1" Align="Align.Center">
                    Nem található komponens, kattints a "Komponens hozzáadása" gombra.
                </MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>