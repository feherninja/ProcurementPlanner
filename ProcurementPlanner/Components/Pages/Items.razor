@page "/items"
@using ProcurementPlanner.Models
@inherits ItemsBase

<PageTitle>Termékek</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudPaper Class="pa-4">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h4">Termékek</MudText>

            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                <MudSelect T="int"
                           Label="Cég"
                           Value="CompanyContext.ActiveCompanyId"
                           ValueChanged="OnCompanyChanged"
                           Dense="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="min-width: 280px;">
                    @foreach (var c in companies)
                    {
                        <MudSelectItem T="int" Value="@c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
                
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">
                    Termék hozzáadása
                </MudButton>
            </MudStack>
        </MudStack>

        <MudDataGrid @ref="dataGrid"
                     T="Item"
                     Items="@items"
                     Filterable="true"
                     FilterMode="DataGridFilterMode.Simple"
                     SortMode="SortMode.Single"
                     Groupable="false"
                     Loading="@loading"
                     Hover="true"
                     Dense="true">

            <Columns>
                <HierarchyColumn T="Item"/>
                <PropertyColumn Property="x => x.Name" Title="Név"/>
                <PropertyColumn Property="x => x.Description" Title="Leírás"/>
                <PropertyColumn Property="x => x.PartNumber" Title="Cikkszám"/>
                <PropertyColumn Property="x => x.DrawingNumber" Title="Rajzszám"/>
                <PropertyColumn Property="x => x.Price" Title="Ár" Format="N2"/>
                <TemplateColumn Title="Komponensek" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">
                            @context.Item.ItemComponents.Count komponens
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.CreatedAt" Title="Létrehozva" Format="yyyy-MM-dd"/>
                <PropertyColumn Property="x => x.UpdatedAt" Title="Módosítva" Format="yyyy-MM-dd"/>

                <TemplateColumn Title="Funkciók" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudStack Row Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(context.Item))"
                                           Title="Szerkesztés"/>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenDeleteDialog(context.Item))"
                                           Title="Törlés"/>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <ChildRowContent>
                <MudCard Class="ma-2" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudText Typo="Typo.h6">@context.Item.Name komponenslistája</MudText>
                            <MudButton Color="Color.Secondary"
                                       Variant="Variant.Filled"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => OpenAddComponentDialog(context.Item))">
                                Komponens hozzáadása
                            </MudButton>
                        </MudStack>

                        @if (context.Item.ItemComponents.Any())
                        {
                            <MudSimpleTable Style="overflow-x: auto;" Dense="true">
                                <thead>
                                <tr>
                                    <th>Céges termékszám</th>
                                    <th>Schwarzmüller termékszám</th>
                                    <th>Komponens</th>
                                    <th>Leírás</th>
                                    <th>Mennyiség</th>
                                    <th>Funkciók</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var itemComponent in context.Item.ItemComponents)
                                {
                                    <tr>
                                        <td>@itemComponent.Component.PartNumber</td>
                                        <td>@itemComponent.Component.ExternalNumber</td>
                                        <td>@itemComponent.Component.Name</td>
                                        <td>@itemComponent.Component.Description</td>
                                        <td>@itemComponent.Quantity</td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => RemoveComponentFromItem(context.Item, itemComponent.Component))"
                                                           Title="Eltávolítás"/>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </MudSimpleTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Nincs hozzáadott komponens. Kattints a "Komponens hozzáadása gombra".
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </ChildRowContent>

            <NoRecordsContent>
                <MudText Typo="Typo.body1" Align="Align.Center">
                    Nem található termék. Kattints a "Termék hozzáadása" gombra.
                </MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>