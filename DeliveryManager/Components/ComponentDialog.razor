@inherits ComponentDialogBase

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="@model" ValidationDelay="0">
            <MudStack Spacing="4">
                <MudTextField @bind-Value="model.Name"
                              Label="Név"
                              Required="true"
                              RequiredError="Név megadása kötelező"
                              For="@(() => model.Name)"/>

                <MudTextField @bind-Value="model.Description"
                              Label="Leírás"
                              Lines="3"
                              For="@(() => model.Description)"/>

                <MudNumericField @bind-Value="model.Stock"
                              Label="Raktármennyiség"
                              Required="true"
                              RequiredError="Raktármennyiség megadása kötelező"
                              For="@(() => model.Stock)"/>

                <MudNumericField @bind-Value="model.OrderPackageSize"
                                 Label="Rendelési kötegszám"
                                 Required="true"
                                 RequiredError="Rendelési kötegszám megadása kötelező"
                                 For="@(() => model.OrderPackageSize)"/>
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Mégse</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@(!form?.IsValid ?? true)">
            @(IsEditMode ? "Mentés" : "Létrehozás")
        </MudButton>
    </DialogActions>
</MudDialog>