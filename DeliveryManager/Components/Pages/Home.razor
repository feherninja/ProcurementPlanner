@page "/"

<h1>Hello, world!</h1>

Welcome to your new app.

<MudCard Class="ma-4">
    <MudCardContent>
        <MudText Typo="Typo.h5">MudBlazor Interactive Test</MudText>
        
        <!-- Test button with snackbar -->
        <MudButton Color="Color.Primary" Variant="Variant.Filled" @onclick="ShowSnackbar">
            Show Snackbar
        </MudButton>
        
        <!-- Test dialog -->
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" @onclick="OpenDialog" Class="ml-2">
            Open Dialog
        </MudButton>
        
        <!-- Test date picker -->
        <MudDatePicker @bind-Date="selectedDate" Label="Pick a date" Class="mt-4" />
        
        <MudText Class="mt-4">Selected date: @selectedDate?.ToString("yyyy-MM-dd")</MudText>
    </MudCardContent>
</MudCard>

@code {
    private DateTime? selectedDate = DateTime.Today;
    
    [Inject] ISnackbar Snackbar { get; set; }
    [Inject] IDialogService DialogService { get; set; }
    
    private void ShowSnackbar()
    {
        Snackbar.Add("Hello from MudBlazor!", Severity.Success);
    }
    
    private async Task OpenDialog()
    {
        await DialogService.ShowMessageBox("Test Dialog", "MudBlazor JavaScript is working!");
    }
}