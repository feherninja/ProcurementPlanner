@using DeliveryManager.Models
@inherits ComponentSelectionDialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4">
            <MudText Typo="Typo.h6">Komponens hozzáadása ehhez: @ItemName</MudText>
            
            @if (availableComponents.Any())
            {
                <MudDataGrid @ref="dataGrid"
                             T="Component"
                             Items="@availableComponents"
                             MultiSelection="true"
                             @bind-SelectedItems="selectedComponents"
                             Filterable="true"
                             FilterMode="DataGridFilterMode.Simple"
                             Dense="true"
                             Height="400px"
                             SelectOnRowClick="false">
                    
                    <Columns>
                        <SelectColumn T="Component" />
                        <TemplateColumn Title="Mennyiség" Sortable="false" Filterable="false">
                            <CellTemplate>
                                @if (selectedComponents.Contains(context.Item))
                                {
                                    <MudNumericField @bind-Value="componentQuantities[context.Item.Id]"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     HideSpinButtons="true"
                                                     Style="max-width: 100px;"
                                                     onclick="event.stopPropagation();" />
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Class="text-muted">-</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Name" Title="Komponens" />
                        <PropertyColumn Property="x => x.Description" Title="Leírás" />
                        <PropertyColumn Property="x => x.Stock" Title="Raktármennyiség" />
                        <PropertyColumn Property="x => x.OrderPackageSize" Title="rendelési kötegszám" />
                        

                    </Columns>
                </MudDataGrid>
                
                @if (selectedComponents.Any())
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @selectedComponents.Count komponens kiválasztva.
                    </MudAlert>
                }
            }
            else
            {
                <MudAlert Severity="Severity.Info">
                    Minden rendelkezésre álló komponens hozzá lett adva a cikkhez.
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    
    <DialogActions>
        <MudButton OnClick="Cancel">Mégse</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="AddSelectedComponents"
                   Disabled="@(!selectedComponents.Any() || loading)">
            @selectedComponents.Count Komponens hozzáadása
        </MudButton>
    </DialogActions>
</MudDialog>