@inherits ItemDialogBase

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="@model" ValidationDelay="0">
            <MudStack Spacing="4">
                <MudTextField @bind-Value="model.Name"
                              Label="Név"
                              Required="true"
                              RequiredError="Név megadása kötelező"
                              For="@(() => model.Name)"/>

                <MudTextField @bind-Value="model.Description"
                              Label="Leírás"
                              For="@(() => model.Description)"/>

                <MudTextField @bind-Value="model.PartNumber"
                              Label="Termékszám"
                              For="@(() => model.PartNumber)"/>

                <MudTextField @bind-Value="model.DrawingNumber"
                              Label="Rajzszám"
                              For="@(() => model.DrawingNumber)"/>

                <MudNumericField @bind-Value="model.Price"
                                 Label="Ár"
                                 For="@(() => model.Price)"/>

                @if (IsEditMode && Item != null && Item.ItemComponents.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Komponensek összértéke: @Item.ItemComponents.Sum(ic => ic.Component.Price * ic.Quantity)
                    </MudText>
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Mégse</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@(!form?.IsValid ?? true)">
            @(IsEditMode ? "Mentés" : "Létrehozás")
        </MudButton>
    </DialogActions>
</MudDialog>