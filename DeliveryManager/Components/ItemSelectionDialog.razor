@using DeliveryManager.Models
@inherits ItemSelectionDialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4">
            <MudText Typo="Typo.h6">Válassza ki a terméket a rendeléshez</MudText>
            
            @if (availableItems.Any())
            {
                <MudTextField @bind-Value="searchString"
                              Placeholder="Keresés cikkszám, rajzszám, név vagy leírás alapján"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

                <MudDataGrid @ref="dataGrid"
                             T="Item"
                             Items="@availableItems"
                             QuickFilter="QuickFilter"
                             MultiSelection="true"
                             @bind-SelectedItems="selectedItems"
                             Filterable="true"
                             FilterMode="DataGridFilterMode.Simple"
                             Dense="true"
                             Height="400px"
                             SelectOnRowClick="false">
                    
                    <Columns>
                        <SelectColumn T="Item" />
                        <TemplateColumn Title="Mennyiség" Sortable="false" Filterable="false">
                            <CellTemplate>
                                @if (selectedItems.Contains(context.Item))
                                {
                                    <MudNumericField Value="@itemQuantities[context.Item.Id]"
                                                     ValueChanged="@((int value) => itemQuantities[context.Item.Id] = value)"
                                                     Min="1"
                                                     Step="1"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     HideSpinButtons="true"
                                                     Style="max-width: 100px;"
                                                     onclick="event.stopPropagation();" />
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Class="text-muted">-</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.PartNumber" Title="Cikkszám" />
                        <PropertyColumn Property="x => x.DrawingNumber" Title="Rajzszám" />
                        <PropertyColumn Property="x => x.Name" Title="Termék" />
                        <PropertyColumn Property="x => x.Description" Title="Leírás" />
                        
                        <TemplateColumn Title="Komponensek" Sortable="false" Filterable="false">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">
                                    @context.Item.ItemComponents.Count komponens
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        
                        
                    </Columns>
                </MudDataGrid>
                
                @if (selectedItems.Any())
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @selectedItems.Count termék kiválasztva.
                    </MudAlert>
                }
            }
            else
            {
                <MudAlert Severity="Severity.Warning">
                    Nincs rendelkezésre álló termék, hozz létre egyet a hozzáadáshoz.
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    
    <DialogActions>
        <MudButton OnClick="Cancel">Mégse</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="AddSelectedItems"
                   Disabled="@(!selectedItems.Any() || loading)">
            @selectedItems.Count termék hozzáadása
        </MudButton>
    </DialogActions>
</MudDialog>